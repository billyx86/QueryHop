{
    "manifest_version": 3,
    "default_locale": "en",

    "name": "__MSG_extension_name__",
    "description": "__MSG_extension_description__",
    "version": "1.0.3",

    "icons": {
        "48": "images/Icon-48.png",
        "96": "images/Icon-96.png",
        "128": "images/Icon-128.png",
        "256": "images/Icon-256.png",
        "512": "images/Icon-512.png"
    },

    "background": {
        "service_worker": "background.js",
        "type": "module"
    },

    "action": {
        "default_popup": "popup.html"
    },

    "permissions": [
        "storage",
        "webNavigation"
    ],

    "host_permissions": [
        "*://*.google.com/*",
        "*://*.google.co.uk/*",
        "*://*.google.de/*",
        "*://*.google.fr/*",
        "*://*.google.ca/*",
        "*://*.google.com.au/*",
        "*://*.google.com.br/*",
        "*://*.google.co.in/*",
        "*://*.google.co.jp/*",
        "*://*.google.es/*",
        "*://*.google.it/*",
        "*://*.google.nl/*",
        "*://*.google.com.mx/*",
        "*://*.google.com.sg/*",
        "*://*.google.com.hk/*",
        "*://*.google.com.tw/*",
        "*://*.google.com.my/*",
        "*://*.google.co.za/*",
        "*://*.google.co.th/*",
        "*://*.google.com.ar/*",
        "*://*.google.com.tr/*",
        "*://*.google.pl/*",
        "*://*.google.ro/*",
        "*://*.google.no/*",
        "*://*.google.dk/*",
        "*://*.google.se/*",
        "*://*.google.fi/*",
        "*://*.google.at/*",
        "*://*.google.ch/*",
        "*://*.google.be/*",
        "*://*.google.pt/*",
        "*://*.google.gr/*",
        "*://*.google.cz/*",
        "*://*.google.hu/*",
        "*://*.google.il/*",
        "*://*.google.co.kr/*",
        "*://*.google.co.nz/*",
        "*://*.google.co.id/*",
        "*://*.google.com.co/*",
        "*://*.google.com.pe/*",
        "*://*.google.com.ve/*",
        "*://*.google.co.ve/*",
        "*://*.google.com.vn/*",
        "*://*.google.com.eg/*",
        "*://*.google.com.gh/*",
        "*://*.google.co.tz/*",
        "*://*.google.com.pk/*",
        "*://*.google.com.bd/*",
        "*://*.google.com.ng/*",
        "*://*.google.co.ke/*",
        "*://*.google.com.ph/*",
        "*://*.google.com.sa/*",
        "*://*.google.com.ua/*",
        "*://*.google.com.gt/*",
        "*://*.google.com.qa/*",
        "*://*.google.com.pr/*",
        "*://*.google.com.uy/*",
        "*://*.google.com.ec/*",
        "*://*.google.com.bo/*",
        "*://*.google.com.do/*",
        "*://*.google.com.lb/*",
        "*://*.google.com.kw/*",
        "*://*.google.com.kz/*",
        "*://*.google.kz/*",
        "*://*.google.com.ge/*",
        "*://*.google.ge/*",
        "*://*.google.com.jo/*",
        "*://*.google.jo/*",
        "*://*.duckduckgo.com/*",
        "*://*.bing.com/search*",
        "*://*.bing.com.cn/search*",
        "*://*.ecosia.org/search*",
        "*://*.baidu.com/s*",
        "*://*.baidu.com.hk/s*",
        "*://*.yahoo.com/*",
        "*://*.yahoo.co.jp/*",
        "*://*.yandex.ru/*",
        "*://*.yandex.kz/*",
        "*://*.yandex.by/*",
        "*://*.yandex.com/*",
        "*://*.yandex.com.tr/*",
        "*://*.search.brave.com/*",
        "*://*.startpage.com/sp/search*",
        "*://*.startpage.com/search*",
        "*://*.you.com/search*"
    ],

    "options_ui": {
        "page": "popup.html",
        "open_in_tab": true
    },

    "_commands": {
        "options": {
            "suggested_key": { "default": "Ctrl+Shift+Y" },
            "description": "__MSG_commands_options_desc__"
        }
    }
}
